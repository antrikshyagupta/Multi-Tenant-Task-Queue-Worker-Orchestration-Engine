generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id                  String   @id @default(uuid())
  name                String   @unique // "free", "pro", "enterprise"
  max_concurrent_jobs Int      @default(2)
  max_queued_jobs     Int      @default(50)
  rate_limit_per_min  Int      @default(60)
  max_payload_bytes   Int      @default(65536) // 64 KB
  weight              Int      @default(1)     // Used in Week 6 Weighted Round Robin
  created_at          DateTime @default(now())

  tenants             Tenant[]
}

model Tenant {
  id           String    @id @default(uuid())
  name         String
  api_key_hash String?   @unique // Kept temporarily so your existing test key keeps working
  plan_id      String?
  status       String    @default("active")
  created_at   DateTime  @default(now())

  plan         Plan?     @relation(fields: [plan_id], references: [id])
  api_keys     ApiKey[]
  jobs         Job[]
}

model ApiKey {
  id           String    @id @default(uuid())
  tenant_id    String
  name         String    @default("Default Key")
  key_prefix   String    // e.g., "sk_live_a1b2" for safe display
  key_hash     String    @unique
  is_active    Boolean   @default(true)
  revoked_at   DateTime?
  last_used_at DateTime?
  created_at   DateTime  @default(now())

  tenant       Tenant    @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, is_active])
}

model Job {
  id              String      @id @default(uuid())
  tenant_id       String
  type            String
  payload         Json
  status          String      @default("CREATED")
  priority        Int         @default(0)
  scheduled_at    DateTime?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  idempotency_key String?     @unique

  tenant          Tenant      @relation(fields: [tenant_id], references: [id])
  executions      Execution[]

  @@index([tenant_id, status])
  @@index([status, priority, created_at])
}

model Execution {
  id                 String    @id @default(uuid())
  job_id             String
  worker_id          String?
  attempt_number     Int       @default(1)
  status             String
  started_at         DateTime?
  finished_at        DateTime?
  execution_duration Int?
  error_message      String?

  job                Job       @relation(fields: [job_id], references: [id])

  @@index([job_id])
}